<script>

/* =====================================================
   HERO BACKGROUND SLIDER
===================================================== */

let images = [

    "https://images2.alphacoders.com/110/thumb-1920-1106518.jpg",

    "https://images8.alphacoders.com/595/595560.jpg",

    "https://motionbgs.com/media/7293/bike-riding-at-night.3840x2160.jpg",

    "https://img.magnific.com/free-photo/man-racing-dirt-bike-fantasy-environment_23-2151500487.jpg?semt=ais_hybrid&w=740&q=80",

    "https://img.magnific.com/free-photo/man-racing-dirt-bike-fantasy-environment_23-2151500495.jpg?semt=ais_hybrid&w=740&q=80"

];


let index = 0;


/* =====================================================
   CHANGE BACKGROUND
===================================================== */

function changeBackground(){

    document.getElementById("hero").style.backgroundImage =
        "url('" + images[index] + "')";

    index++;

    if(index === images.length){

        index = 0;

    }

}


/* =====================================================
   CHANGE EVERY 4 SECONDS
===================================================== */

setInterval(
    changeBackground,
    4000
);


/* =====================================================
   LOAD FIRST BACKGROUND
===================================================== */

changeBackground();

</script>


