<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Futuristic Car Showroom</title>

<style>

/* =====================================================
   CONTROL SETTINGS
===================================================== */

:root{
    --red:#ff003c;
    --red-light:#ff315c;
    --white:#ffffff;

    --title-size:82px;
    --overlay:.58;

    --glow:
        0 0 10px var(--red),
        0 0 30px var(--red),
        0 0 70px rgba(255,0,60,.7);
}


/* =====================================================
   RESET
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,
body{
    width:100%;
    height:100%;
}

body{
    background:#000;
    color:white;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    overflow:hidden;
}


/* =====================================================
   HERO
===================================================== */

.hero{

    position:relative;

    width:100%;
    height:100vh;

    overflow:hidden;

    background:#000;
}


/* =====================================================
   CINEMATIC SLIDES
===================================================== */

.slide{

    position:absolute;

    inset:0;

    width:100%;
    height:100%;

    background-size:cover;
    background-position:center;

    opacity:0;

    animation:
        cinematicFade 30s infinite;

    transform:scale(1.08);

}


/* =====================================================
   SLIDE IMAGES
===================================================== */

.slide:nth-child(1){

    background-image:url(
        "https://c.ndtvimg.com/2022-01/14tg328o_car_625x300_11_January_22.jpg"
    );

    animation-delay:0s;
}


.slide:nth-child(2){

    background-image:url(
        "https://static.vecteezy.com/system/resources/thumbnails/047/734/585/small/futuristic-electric-car-with-neon-lights-on-water-at-sunset-showcasing-ecofriendly-transportation-photo.jpg"
    );

    animation-delay:6s;
}


.slide:nth-child(3){

    background-image:url(
        "https://www.thearabtoday.com/wp-content/uploads/2024/07/Rolls-Royce-Boat-Tail.jpg"
    );

    animation-delay:12s;
}


.slide:nth-child(4){

    background-image:url(
        "https://media.assettype.com/thequint%2F2016-06%2F4cac58dd-a63b-4e2b-b69d-c43e296e8389%2Frolls.jpg?auto=format%2Ccompress&fmt=webp&width=720"
    );

    animation-delay:18s;
}


.slide:nth-child(5){

    background-image:url(
        "https://static0.hotcarsimages.com/wordpress/wp-content/uploads/2021/11/Mercedes-Benz-Vision-AVTR-(1).jpg?w=1200&h=628&fit=crop"
    );

    animation-delay:24s;
}


/* =====================================================
   CINEMATIC ANIMATION
===================================================== */

@keyframes cinematicFade{

    0%{
        opacity:0;
        transform:scale(1.08);
    }

    5%{
        opacity:1;
    }

    20%{
        opacity:1;
    }

    25%{
        opacity:0;
        transform:scale(1);
    }

    100%{
        opacity:0;
        transform:scale(1);
    }

}


/* =====================================================
   DARK CINEMATIC OVERLAY
===================================================== */

.hero::before{

    content:"";

    position:absolute;

    inset:0;

    z-index:1;

    background:

        linear-gradient(
            90deg,
            rgba(0,0,0,.90) 0%,
            rgba(0,0,0,.55) 38%,
            rgba(0,0,0,.20) 70%,
            rgba(0,0,0,.65) 100%
        ),

        linear-gradient(
            0deg,
            rgba(0,0,0,.85),
            transparent 45%,
            rgba(0,0,0,.35)
        );
}


/* =====================================================
   RED AMBIENT LIGHT
===================================================== */

.ambient{

    position:absolute;

    width:600px;
    height:600px;

    left:-250px;
    top:25%;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(255,0,60,.20),
            transparent 70%
        );

    filter:blur(40px);

    z-index:1;

    pointer-events:none;
}


/* =====================================================
   FUTURISTIC GRID
===================================================== */

.grid{

    position:absolute;

    left:0;
    bottom:-170px;

    width:100%;
    height:48%;

    z-index:2;

    transform:
        perspective(450px)
        rotateX(62deg);

    background-image:

        linear-gradient(
            rgba(255,0,60,.15) 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            rgba(255,0,60,.15) 1px,
            transparent 1px
        );

    background-size:
        65px 65px;

    mask-image:
        linear-gradient(
            to top,
            black,
            transparent
        );

    pointer-events:none;
}


/* =====================================================
   TOP NAVIGATION
===================================================== */

.top-bar{

    position:absolute;

    top:25px;
    left:35px;
    right:35px;

    display:flex;

    justify-content:space-between;
    align-items:center;

    z-index:10;
}


/* =====================================================
   LOGO
===================================================== */

.logo-area{

    display:flex;

    align-items:center;

    gap:14px;

    cursor:pointer;

    padding:
        10px 18px;

    border-left:
        2px solid var(--red);

    background:
        linear-gradient(
            90deg,
            rgba(255,0,60,.10),
            transparent
        );

    transition:.3s;
}


.logo-area:hover{

    background:
        linear-gradient(
            90deg,
            rgba(255,0,60,.22),
            transparent
        );

}


.logo-area img{

    width:45px;

    filter:
        drop-shadow(0 0 8px var(--red))
        drop-shadow(0 0 20px var(--red));
}


.logo-area span{

    font-size:17px;

    font-weight:bold;

    letter-spacing:4px;

    color:white;

    text-shadow:
        0 0 10px rgba(255,255,255,.5);
}


/* =====================================================
   TOP RIGHT STATUS
===================================================== */

.system-status{

    display:flex;

    align-items:center;

    gap:10px;

    font-size:10px;

    letter-spacing:4px;

    color:#aaa;
}


.status-dot{

    width:7px;
    height:7px;

    border-radius:50%;

    background:var(--red);

    box-shadow:
        0 0 8px var(--red),
        0 0 20px var(--red);

    animation:pulse 1.5s infinite;
}


@keyframes pulse{

    0%,
    100%{
        opacity:.4;
    }

    50%{
        opacity:1;
    }

}


/* =====================================================
   MAIN CONTENT
===================================================== */

.main-text{

    position:absolute;

    left:80px;

    top:50%;

    transform:
        translateY(-50%);

    z-index:5;
}


/* =====================================================
   SMALL LABEL
===================================================== */

.eyebrow{

    display:flex;

    align-items:center;

    gap:12px;

    margin-bottom:20px;

    font-size:11px;

    letter-spacing:7px;

    color:#aaa;
}


.eyebrow-line{

    width:55px;
    height:1px;

    background:var(--red);

    box-shadow:
        0 0 10px var(--red);
}


/* =====================================================
   MAIN TITLE
===================================================== */

.main-text h1{

    font-size:var(--title-size);

    line-height:.95;

    font-weight:800;

    letter-spacing:5px;

    color:white;

    text-transform:uppercase;

    text-shadow:

        0 0 3px white,

        0 0 15px rgba(255,255,255,.3),

        0 0 40px rgba(255,0,60,.35);
}


.main-text h1 span{

    color:var(--red);

    text-shadow:var(--glow);
}


/* =====================================================
   DESCRIPTION
===================================================== */

.description{

    margin-top:25px;

    max-width:500px;

    font-size:13px;

    line-height:1.8;

    letter-spacing:2px;

    color:#aaa;
}


/* =====================================================
   COMING SOON
===================================================== */

.coming-wrapper{

    margin-top:32px;

    display:flex;

    align-items:center;

    gap:20px;
}


.coming{

    position:relative;

    padding:
        13px 25px;

    border:
        1px solid var(--red);

    color:white;

    font-size:17px;

    font-weight:bold;

    letter-spacing:7px;

    background:
        rgba(255,0,60,.07);

    box-shadow:

        inset 0 0 20px rgba(255,0,60,.08),

        0 0 15px rgba(255,0,60,.25);
}


.coming::before{

    content:"";

    position:absolute;

    top:-1px;
    left:-1px;

    width:25px;
    height:25px;

    border-top:
        2px solid white;

    border-left:
        2px solid white;
}


.coming::after{

    content:"";

    position:absolute;

    bottom:-1px;
    right:-1px;

    width:25px;
    height:25px;

    border-bottom:
        2px solid white;

    border-right:
        2px solid white;
}


/* =====================================================
   DISCOVER LINE
===================================================== */

.discover{

    font-size:10px;

    letter-spacing:4px;

    color:#777;
}


/* =====================================================
   SIDE HUD
===================================================== */

.hud{

    position:absolute;

    right:45px;

    top:50%;

    transform:
        translateY(-50%);

    z-index:5;

    display:flex;

    flex-direction:column;

    gap:20px;
}


.hud-line{

    width:120px;
    height:1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--red)
        );

    box-shadow:
        0 0 8px var(--red);
}


.hud-text{

    font-size:9px;

    letter-spacing:3px;

    color:#777;

    writing-mode:
        vertical-rl;
}


/* =====================================================
   SCAN LINE
===================================================== */

.scan-line{

    position:absolute;

    left:0;

    width:100%;

    height:1px;

    top:0;

    z-index:4;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,0,60,.65),
            transparent
        );

    box-shadow:
        0 0 10px var(--red);

    animation:
        scan 7s linear infinite;

    opacity:.35;
}


@keyframes scan{

    0%{
        top:10%;
    }

    50%{
        top:90%;
    }

    100%{
        top:10%;
    }

}


/* =====================================================
   CORNER FRAME
===================================================== */

.corner{

    position:absolute;

    width:90px;
    height:90px;

    z-index:6;

    opacity:.7;
}


.corner.top-left{

    top:15px;
    left:15px;

    border-top:
        1px solid var(--red);

    border-left:
        1px solid var(--red);
}


.corner.top-right{

    top:15px;
    right:15px;

    border-top:
        1px solid var(--red);

    border-right:
        1px solid var(--red);
}


.corner.bottom-left{

    bottom:15px;
    left:15px;

    border-bottom:
        1px solid var(--red);

    border-left:
        1px solid var(--red);
}


.corner.bottom-right{

    bottom:15px;
    right:15px;

    border-bottom:
        1px solid var(--red);

    border-right:
        1px solid var(--red);
}


/* =====================================================
   BOTTOM BAR
===================================================== */

.bottom-bar{

    position:absolute;

    left:35px;
    right:35px;
    bottom:25px;

    z-index:10;

    display:flex;

    justify-content:space-between;
    align-items:center;

    font-size:9px;

    letter-spacing:4px;

    color:#777;
}


.bottom-center{

    position:absolute;

    left:50%;

    transform:
        translateX(-50%);

    color:white;

    text-shadow:
        0 0 10px white;
}


/* =====================================================
   MUSIC ICON
===================================================== */

.music{

    display:flex;

    align-items:center;

    gap:10px;

    cursor:pointer;

    transition:.3s;
}


.music:hover{
    color:white;
}


.music-icon{

    width:28px;
    height:28px;

    display:flex;

    align-items:center;
    justify-content:center;

    border:
        1px solid #555;

    color:var(--red);

    box-shadow:
        0 0 10px rgba(255,0,60,.15);
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:1000px){

    .main-text{
        left:50px;
    }

    .main-text h1{
        font-size:60px;
    }

    .description{
        max-width:400px;
    }

}


@media(max-width:700px){

    .top-bar{
        left:20px;
        right:20px;
    }

    .logo-area span{
        font-size:12px;
        letter-spacing:2px;
    }

    .system-status{
        display:none;
    }

    .main-text{
        left:30px;
        right:30px;
    }

    .main-text h1{
        font-size:45px;
        letter-spacing:3px;
    }

    .description{
        font-size:10px;
    }

    .coming{
        font-size:12px;
        letter-spacing:4px;
    }

    .hud{
        display:none;
    }

    .bottom-bar{
        left:20px;
        right:20px;
    }

    .bottom-center{
        display:none;
    }

}


/* =====================================================
   ACCESSIBILITY
===================================================== */

@media(prefers-reduced-motion:reduce){

    .slide,
    .scan-line,
    .status-dot{
        animation:none;
    }

}

</style>

</head>


<body>


<div class="hero">


    <!-- ================================================
         BACKGROUND
    ================================================= -->

    <div class="slide"></div>
    <div class="slide"></div>
    <div class="slide"></div>
    <div class="slide"></div>
    <div class="slide"></div>


    <!-- AMBIENT LIGHT -->

    <div class="ambient"></div>


    <!-- FUTURISTIC FLOOR -->

    <div class="grid"></div>


    <!-- SCANNING EFFECT -->

    <div class="scan-line"></div>


    <!-- CORNER FRAME -->

    <div class="corner top-left"></div>
    <div class="corner top-right"></div>
    <div class="corner bottom-left"></div>
    <div class="corner bottom-right"></div>


    <!-- ================================================
         TOP BAR
    ================================================= -->

    <div class="top-bar">


        <!-- LOGO -->

        <div
            class="logo-area"
            onclick="toggleMusic()"
        >

            <img
                src="https://cdn-icons-png.flaticon.com/512/2972/2972185.png"
                alt="Car"
            >

            <span>
                FUTURE CAR SHOWROOM
            </span>

        </div>


        <!-- SYSTEM STATUS -->

        <div class="system-status">

            <span class="status-dot"></span>

            SYSTEM ONLINE

        </div>


    </div>


    <!-- ================================================
         MAIN TEXT
    ================================================= -->

    <div class="main-text">


        <div class="eyebrow">

            <span class="eyebrow-line"></span>

            THE NEXT GENERATION

        </div>


        <h1>

            FUTURE<br>

            <span>CAR</span>

            SHOWROOM

        </h1>


        <div class="description">

            ENTER A NEW ERA OF AUTOMOTIVE DESIGN,
            ADVANCED TECHNOLOGY AND UNLIMITED
            PERFORMANCE.

        </div>


        <div class="coming-wrapper">

            <div class="coming">

                COMING SOON

            </div>

            <div class="discover">

                EXPERIENCE THE FUTURE

            </div>

        </div>


    </div>


    <!-- ================================================
         RIGHT HUD
    ================================================= -->

    <div class="hud">

        <div class="hud-line"></div>

        <div class="hud-text">

            FUTURE MOBILITY
            //
            DESIGN
            //
            PERFORMANCE

        </div>

        <div class="hud-line"></div>

    </div>


    <!-- ================================================
         BOTTOM BAR
    ================================================= -->

    <div class="bottom-bar">


        <div>

            EST. 2026

        </div>


        <div class="bottom-center">

            INNOVATION // PERFORMANCE // DESIGN

        </div>


        <div
            class="music"
            onclick="toggleMusic()"
        >

            <div class="music-icon">

                ♪

            </div>

            <span id="musicText">

                SOUND OFF

            </span>

        </div>


    </div>


</div>


<!-- ================================================
     MUSIC
================================================= -->

<audio
    id="music"
    loop
>

    <source
        src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_8c1a0e1e71.mp3"
        type="audio/mpeg"
    >

</audio>


<script>

/* =====================================================
   MUSIC CONTROL
===================================================== */

const music =
    document.getElementById("music");

const musicText =
    document.getElementById("musicText");

let playing = false;


function toggleMusic(){

    if(!playing){

        music.play();

        playing = true;

        musicText.innerText =
            "SOUND ON";

    }

    else{

        music.pause();

        playing = false;

        musicText.innerText =
            "SOUND OFF";

    }

}

</script>


</body>
</html>
