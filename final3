<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050507">
<title>ORVIX — Future Mobility</title>

<style>
:root{
    --accent:#ff174f;
    --accent-soft:#ff4f78;
    --white:#f8f8fa;
    --muted:#a4a6ad;
    --line:rgba(255,255,255,.12);
    --glass:rgba(10,10,14,.42);
    --title:clamp(48px,7.2vw,104px);
    --ease:cubic-bezier(.2,.75,.2,1);
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{width:100%;height:100%}
body{
    background:#030305;
    color:var(--white);
    font-family:Inter,Arial,Helvetica,sans-serif;
    overflow:hidden;
    -webkit-font-smoothing:antialiased;
}
button{font:inherit}

.hero{
    position:relative;
    width:100%;
    height:100vh;
    min-height:620px;
    overflow:hidden;
    isolation:isolate;
    background:#030305;
}

/* BACKGROUND */
.slide{
    position:absolute;
    inset:0;
    background-size:cover;
    background-position:center;
    opacity:0;
    transform:scale(1.075);
    animation:cinematicFade 30s infinite;
    filter:saturate(.9) contrast(1.06);
}
.slide:nth-child(1){
    background-image:url("https://www.jalopnik.com/jalopnik/images/eebcd3b9afca580e2a96a0ab9532bac7.jpg");
    animation-delay:0s;
}
.slide:nth-child(2){
    background-image:url("https://image.cnbcfm.com/api/v1/image/107106096-1660848311022-Lincoln_Model_L100_Concept_Exterior_1.jpg?v=1660848332");
    animation-delay:6s;
}
.slide:nth-child(3){
    background-image:url("https://img.magnific.com/free-photo/futuristic-car-illustration_23-2151685442.jpg?semt=ais_hybrid&w=740&q=80");
    animation-delay:12s;
}
.slide:nth-child(4){
    background-image:url("https://www.ecoticias.com/en/wp-content/uploads/2025/01/0183c6f23597828c24d32c9e253d05b9-1-1.jpg");
    animation-delay:18s;
}
.slide:nth-child(5){
    background-image:url("https://png.pngtree.com/thumb_back/fw800/background/20260610/pngtree-futuristic-autonomous-car-speeding-through-a-neon-cityscape-at-night-image_21911453.webp");
    animation-delay:24s;
}
@keyframes cinematicFade{
    0%{opacity:0;transform:scale(1.075)}
    5%,20%{opacity:1}
    25%{opacity:0;transform:scale(1)}
    100%{opacity:0;transform:scale(1)}
}

/* CINEMATIC COLOR GRADE */
.hero::before{
    content:"";
    position:absolute;
    inset:0;
    z-index:1;
    background:
        radial-gradient(circle at 74% 48%,rgba(255,23,79,.10),transparent 30%),
        linear-gradient(90deg,rgba(0,0,0,.94) 0%,rgba(0,0,0,.70) 32%,rgba(0,0,0,.18) 70%,rgba(0,0,0,.58) 100%),
        linear-gradient(0deg,rgba(0,0,0,.94),transparent 42%,rgba(0,0,0,.38));
    pointer-events:none;
}
.hero::after{
    content:"";
    position:absolute;
    inset:0;
    z-index:8;
    pointer-events:none;
    background:linear-gradient(115deg,transparent 0 46%,rgba(255,255,255,.025) 50%,transparent 54%);
    mix-blend-mode:screen;
}

/* AMBIENT LIGHT */
.ambient{
    position:absolute;
    width:620px;height:620px;
    left:-260px;top:20%;
    border-radius:50%;
    background:radial-gradient(circle,rgba(255,23,79,.18),transparent 68%);
    filter:blur(48px);
    z-index:2;
    pointer-events:none;
}

/* GRID */
.grid{
    position:absolute;
    left:-5%;bottom:-205px;
    width:110%;height:47%;
    z-index:3;
    transform:perspective(520px) rotateX(62deg);
    background-image:
        linear-gradient(rgba(255,23,79,.12) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,23,79,.12) 1px,transparent 1px);
    background-size:70px 70px;
    mask-image:linear-gradient(to top,#000,transparent);
    opacity:.72;
    pointer-events:none;
}

/* TOP BAR */
.top-bar{
    position:absolute;
    top:28px;left:38px;right:38px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    z-index:20;
}
.logo-area{
    display:flex;
    align-items:center;
    gap:14px;
    cursor:pointer;
    padding:11px 18px 11px 13px;
    border:1px solid rgba(255,255,255,.11);
    border-left:2px solid var(--accent);
    background:linear-gradient(90deg,rgba(0,0,0,.42),rgba(0,0,0,.08));
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    transition:transform .35s var(--ease),border-color .35s ease,background .35s ease;
}
.logo-area:hover{
    transform:translateY(-2px);
    border-color:rgba(255,23,79,.45);
    background:linear-gradient(90deg,rgba(255,23,79,.12),rgba(0,0,0,.08));
}
.logo-area img{
    width:43px;height:43px;
    object-fit:contain;
    filter:drop-shadow(0 0 8px rgba(255,23,79,.28));
}
.logo-area span{
    font-size:15px;
    font-weight:800;
    letter-spacing:4px;
    color:#fff;
    text-shadow:none;
    white-space:nowrap;
}
.system-status{
    display:flex;align-items:center;gap:11px;
    padding:9px 13px;
    border:1px solid rgba(255,255,255,.10);
    background:rgba(0,0,0,.25);
    backdrop-filter:blur(12px);
    font-size:9px;letter-spacing:3px;color:#aaa;
}
.status-dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--accent);
    box-shadow:0 0 10px var(--accent);
    animation:pulse 1.8s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}

/* CONTENT */
.main-text{
    position:absolute;
    left:clamp(30px,7vw,105px);
    top:50%;
    transform:translateY(-45%);
    z-index:10;
    max-width:900px;
}
.eyebrow{
    display:flex;align-items:center;gap:12px;
    margin-bottom:23px;
    font-size:10px;letter-spacing:6px;color:#b9bac0;
    text-transform:uppercase;
}
.eyebrow-line{
    width:52px;height:1px;background:var(--accent);
    box-shadow:0 0 12px rgba(255,23,79,.7);
}
.main-text h1{
    font-size:var(--title);
    line-height:.9;
    font-weight:850;
    letter-spacing:-2px;
    text-transform:uppercase;
    color:#fff;
    text-wrap:balance;
    text-shadow:0 2px 24px rgba(0,0,0,.4);
}
.main-text h1 span{
    color:var(--accent);
    text-shadow:0 0 18px rgba(255,23,79,.18);
}
.description{
    margin-top:28px;
    max-width:520px;
    font-size:12px;
    line-height:1.9;
    letter-spacing:2.2px;
    color:#b2b3b9;
}

/* CTA */
.coming-wrapper{
    margin-top:34px;
    display:flex;align-items:center;gap:22px;
}
.coming{
    position:relative;
    display:inline-flex;align-items:center;justify-content:center;
    min-width:190px;
    padding:15px 25px;
    border:1px solid rgba(255,23,79,.85);
    color:#fff;
    font-size:12px;
    font-weight:800;
    letter-spacing:5px;
    background:linear-gradient(135deg,rgba(255,23,79,.18),rgba(255,23,79,.04));
    box-shadow:inset 0 0 22px rgba(255,23,79,.07),0 8px 30px rgba(0,0,0,.25);
    overflow:hidden;
    cursor:pointer;
    transition:transform .28s var(--ease),background .28s ease,box-shadow .28s ease;
}
.coming::before{
    content:"";
    position:absolute;
    inset:0;
    transform:translateX(-110%);
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.22),transparent);
    transition:transform .65s ease;
}
.coming:hover{
    transform:translateY(-3px);
    background:rgba(255,23,79,.17);
    box-shadow:inset 0 0 25px rgba(255,23,79,.10),0 12px 38px rgba(255,23,79,.13);
}
.coming:hover::before{transform:translateX(110%)}
.discover{
    font-size:9px;letter-spacing:3px;color:#777;
    white-space:nowrap;
}

/* RIGHT HUD */
.hud{
    position:absolute;
    right:48px;top:50%;
    transform:translateY(-50%);
    z-index:10;
    display:flex;flex-direction:column;align-items:flex-end;gap:20px;
}
.hud-line{
    width:110px;height:1px;
    background:linear-gradient(90deg,transparent,var(--accent));
    box-shadow:0 0 8px rgba(255,23,79,.55);
}
.hud-text{
    font-size:8px;letter-spacing:3px;line-height:2.1;color:#777;
    writing-mode:vertical-rl;
}

/* SCAN */
.scan-line{
    position:absolute;left:0;width:100%;height:1px;top:0;
    z-index:7;
    background:linear-gradient(90deg,transparent,rgba(255,23,79,.7),transparent);
    box-shadow:0 0 12px var(--accent);
    animation:scan 8s linear infinite;
    opacity:.25;
}
@keyframes scan{0%{top:10%}50%{top:90%}100%{top:10%}}

/* CORNERS */
.corner{
    position:absolute;width:72px;height:72px;
    z-index:12;opacity:.55;
}
.corner.top-left{top:16px;left:16px;border-top:1px solid var(--accent);border-left:1px solid var(--accent)}
.corner.top-right{top:16px;right:16px;border-top:1px solid var(--accent);border-right:1px solid var(--accent)}
.corner.bottom-left{bottom:16px;left:16px;border-bottom:1px solid var(--accent);border-left:1px solid var(--accent)}
.corner.bottom-right{bottom:16px;right:16px;border-bottom:1px solid var(--accent);border-right:1px solid var(--accent)}

/* BOTTOM */
.bottom-bar{
    position:absolute;left:38px;right:38px;bottom:27px;
    z-index:20;
    display:flex;justify-content:space-between;align-items:center;
    font-size:8px;letter-spacing:3px;color:#707178;
}
.bottom-center{
    position:absolute;left:50%;transform:translateX(-50%);
    color:#a0a1a6;
}

/* FADE-IN UI */
.top-bar,.main-text,.hud,.bottom-bar,.corner{
    animation:uiIn 1.1s var(--ease) both;
}
.main-text{animation-delay:.12s}
.hud{animation-delay:.28s}
.bottom-bar{animation-delay:.42s}
@keyframes uiIn{
    from{opacity:0;transform:translateY(12px)}
    to{opacity:1;transform:translateY(0)}
}
.main-text{animation-name:contentIn}
@keyframes contentIn{
    from{opacity:0;transform:translateY(calc(-45% + 18px))}
    to{opacity:1;transform:translateY(-45%)}
}

/* RESPONSIVE */
@media(max-width:1000px){
    .main-text{left:50px}
    .hud{right:25px}
    .description{max-width:440px}
}
@media(max-width:700px){
    .hero{min-height:560px}
    .top-bar{top:18px;left:20px;right:20px}
    .logo-area{padding:8px 11px;gap:9px}
    .logo-area img{width:34px;height:34px}
    .logo-area span{font-size:10px;letter-spacing:2.2px}
    .system-status{display:none}
    .main-text{left:28px;right:28px;top:48%}
    .main-text h1{font-size:clamp(42px,12vw,65px);letter-spacing:-1px}
    .description{font-size:10px;line-height:1.75;letter-spacing:1.5px}
    .coming-wrapper{align-items:flex-start;flex-direction:column;gap:13px}
    .coming{min-width:170px;padding:13px 18px;font-size:10px}
    .discover{font-size:8px}
    .hud{display:none}
    .bottom-bar{left:20px;right:20px;bottom:18px}
    .bottom-center{display:none}
    .corner{width:48px;height:48px}
}
@media(prefers-reduced-motion:reduce){
    .slide,.scan-line,.status-dot,.top-bar,.main-text,.hud,.bottom-bar,.corner{animation:none}
}
</style>
</head>

<body>
<div class="hero">

    <div class="slide"></div>
    <div class="slide"></div>
    <div class="slide"></div>
    <div class="slide"></div>
    <div class="slide"></div>

    <div class="ambient"></div>
    <div class="grid"></div>
    <div class="scan-line"></div>

    <div class="corner top-left"></div>
    <div class="corner top-right"></div>
    <div class="corner bottom-left"></div>
    <div class="corner bottom-right"></div>

    <div class="top-bar">
        <div class="logo-area" aria-label="ORVIX Car Showroom">
            <img src="https://i.insider.com/57694de3dd0895261f8b47aa?width=700" alt="ORVIX">
            <span>ORVIX CAR SHOWROOM</span>
        </div>

        <div class="system-status">
            <span class="status-dot"></span>
            SYSTEM ONLINE
        </div>
    </div>

    <main class="main-text">
        <div class="eyebrow">
            <span class="eyebrow-line"></span>
            THE NEXT GENERATION
        </div>

        <h1>
            ORVIX FUTURISTIC<br>
            <span>CAR</span> SHOWROOM
        </h1>

        <div class="description">
            ENTER A NEW ERA OF AUTOMOTIVE DESIGN,
            ADVANCED TECHNOLOGY AND UNLIMITED
            PERFORMANCE.
        </div>

        <div class="coming-wrapper">
            <div class="coming" role="button" tabindex="0" onclick="this.animate([{transform:'scale(.97)'},{transform:'scale(1)'}],{duration:180})">
                COMING SOON
            </div>
            <div class="discover">THE FUTURE OF MOBILITY • 2027</div>
        </div>
    </main>

    <div class="hud">
        <div class="hud-line"></div>
        <div class="hud-text">
            FUTURE MOBILITY<br>
            DESIGN<br>
            PERFORMANCE
        </div>
        <div class="hud-line"></div>
    </div>

    <div class="bottom-bar">
        <div>EST. 2027</div>
        <div class="bottom-center">INNOVATION // PERFORMANCE // DESIGN</div>
    </div>
</div>
</body>
</html>
