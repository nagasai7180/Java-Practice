<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Futuristic Bike Showroom</title>

<style>

/* =====================================================
   FUTURISTIC BIKE SHOWROOM
===================================================== */

:root{
    --cyan:#00f7ff;
    --blue:#008cff;
    --dark:#02070b;

    --title-size:64px;

    --card-width:280px;
    --card-height:400px;

    --card-gap:28px;

    --glow-strength:0.7;
}

/* =====================================================
   RESET
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,
body{
    width:100%;
    height:100%;
}

body{
    background:#000;
    color:white;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    overflow:hidden;
}

/* =====================================================
   MAIN SCREEN
===================================================== */

.showroom{

    position:relative;

    width:100%;
    height:100vh;

    overflow:hidden;

    background:
        radial-gradient(
            circle at 50% 50%,
            rgba(0,180,255,0.10),
            transparent 55%
        ),
        #000;
}

/* =====================================================
   FUTURISTIC GRID
===================================================== */

.grid{

    position:absolute;

    left:-10%;
    bottom:-30%;

    width:120%;
    height:80%;

    transform:
        perspective(500px)
        rotateX(62deg);

    background-image:

        linear-gradient(
            rgba(0,247,255,0.16) 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            rgba(0,247,255,0.16) 1px,
            transparent 1px
        );

    background-size:
        60px 60px;

    mask-image:
        linear-gradient(
            to top,
            black,
            transparent
        );

    pointer-events:none;
}

/* =====================================================
   TOP LIGHT
===================================================== */

.top-light{

    position:absolute;

    top:-250px;
    left:50%;

    transform:translateX(-50%);

    width:700px;
    height:500px;

    background:
        radial-gradient(
            ellipse,
            rgba(0,247,255,0.18),
            transparent 65%
        );

    filter:blur(20px);

    pointer-events:none;
}

/* =====================================================
   SIDE LIGHTS
===================================================== */

.side-light{

    position:absolute;

    width:3px;
    height:65%;

    top:20%;

    background:
        linear-gradient(
            transparent,
            var(--cyan),
            transparent
        );

    box-shadow:
        0 0 15px var(--cyan),
        0 0 40px rgba(0,247,255,0.5);

    opacity:.45;
}

.side-light.left{
    left:25px;
}

.side-light.right{
    right:25px;
}

/* =====================================================
   HEADER
===================================================== */

.header{

    position:absolute;

    top:35px;
    left:0;

    width:100%;

    text-align:center;

    z-index:10;
}

/* small text */

.header-small{

    font-size:12px;

    letter-spacing:8px;

    color:#7defff;

    margin-bottom:12px;

    opacity:.8;
}

/* MAIN TITLE */

.title{

    font-size:var(--title-size);

    font-weight:700;

    letter-spacing:7px;

    color:white;

    text-shadow:

        0 0 5px white,

        0 0 15px var(--cyan),

        0 0 35px var(--cyan),

        0 0 70px rgba(0,247,255,.6);
}

/* =====================================================
   TITLE LINE
===================================================== */

.title-line{

    margin:18px auto 0;

    width:420px;
    height:1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--cyan),
            transparent
        );

    box-shadow:
        0 0 12px var(--cyan);
}

/* =====================================================
   BIKE AREA
===================================================== */

.bike-area{

    position:absolute;

    top:52%;

    left:50%;

    transform:
        translate(-50%,-50%);

    display:flex;

    align-items:center;

    justify-content:center;

    gap:var(--card-gap);

    width:max-content;

    z-index:5;
}

/* =====================================================
   BIKE CARD
===================================================== */

.card{

    position:relative;

    width:var(--card-width);
    height:var(--card-height);

    overflow:hidden;

    background:#05090d;

    border:

        1px solid
        rgba(0,247,255,.45);

    border-radius:6px;

    transform:
        skewX(-5deg);

    cursor:pointer;

    transition:
        transform .45s ease,
        box-shadow .45s ease,
        border-color .45s ease;

    box-shadow:

        0 0 12px rgba(0,247,255,.15),

        inset 0 0 25px
        rgba(0,247,255,.05);
}

/* =====================================================
   CARD HOVER
===================================================== */

.card:hover{

    transform:
        skewX(-5deg)
        translateY(-18px)
        scale(1.04);

    border-color:
        var(--cyan);

    box-shadow:

        0 0 20px
        rgba(0,247,255,.45),

        0 0 55px
        rgba(0,247,255,.22),

        inset 0 0 35px
        rgba(0,247,255,.08);
}

/* =====================================================
   CARD IMAGE
===================================================== */

.card-image{

    position:absolute;

    inset:0;

    background-size:cover;

    background-position:center;

    transition:
        transform .6s ease,
        filter .6s ease;
}

.card:hover .card-image{

    transform:scale(1.08);

    filter:
        brightness(1.15)
        saturate(1.15);
}

/* =====================================================
   IMAGE DARK OVERLAY
===================================================== */

.card-image::after{

    content:"";

    position:absolute;

    inset:0;

    background:

        linear-gradient(
            to bottom,
            rgba(0,0,0,.15),
            rgba(0,0,0,.05) 40%,
            rgba(0,0,0,.92)
        );
}

/* =====================================================
   CARD TOP NUMBER
===================================================== */

.card-number{

    position:absolute;

    top:18px;
    left:25px;

    font-size:12px;

    letter-spacing:3px;

    color:
        var(--cyan);

    transform:
        skewX(5deg);

    z-index:3;

    text-shadow:
        0 0 10px var(--cyan);
}

/* =====================================================
   CARD CORNER
===================================================== */

.card-corner{

    position:absolute;

    top:0;
    right:0;

    width:45px;
    height:45px;

    border-top:
        2px solid var(--cyan);

    border-right:
        2px solid var(--cyan);

    opacity:.7;

    z-index:3;
}

/* =====================================================
   CARD CONTENT
===================================================== */

.card-content{

    position:absolute;

    bottom:25px;

    left:25px;
    right:20px;

    transform:
        skewX(5deg);

    z-index:5;
}

/* =====================================================
   BIKE NAME
===================================================== */

.bike-name{

    font-size:25px;

    font-weight:bold;

    letter-spacing:3px;

    color:white;

    text-shadow:

        0 0 8px white,

        0 0 18px var(--cyan);
}

/* =====================================================
   BIKE TYPE
===================================================== */

.bike-type{

    margin-top:7px;

    font-size:10px;

    letter-spacing:4px;

    color:#72eaff;

    opacity:.8;
}

/* =====================================================
   BUTTON
===================================================== */

.view-button{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    margin-top:18px;

    padding:

        9px 20px;

    border:

        1px solid
        var(--cyan);

    color:var(--cyan);

    background:
        rgba(0,247,255,.04);

    font-size:11px;

    letter-spacing:3px;

    transition:.3s;

    box-shadow:
        inset 0 0 10px
        rgba(0,247,255,.04);

}

/* button hover */

.card:hover .view-button{

    color:#000;

    background:
        var(--cyan);

    box-shadow:

        0 0 15px
        var(--cyan),

        0 0 30px
        rgba(0,247,255,.5);
}

/* =====================================================
   CARD IMAGES
===================================================== */

.card1 .card-image{

    background-image:url(
        "https://www.slashgear.com/img/gallery/6-futuristic-motorcycles-that-actually-exist/arc-vector-1733391512.jpg"
    );
}

.card2 .card-image{

    background-image:url(
        "https://mir-s3-cdn-cf.behance.net/project_modules/fs/51974a34438857.56d1cded3a57e.jpg"
    );
}

.card3 .card-image{

    background-image:url(
        "https://i.pinimg.com/originals/84/d2/7b/84d27bf05fb6b6ecd6a24f559a619e39.jpg"
    );
}

.card4 .card-image{

    background-image:url(
        "https://wirecase3d.com/cdn/shop/products/bike1.jpg?v=1532863204&width=1445"
    );
}

/* =====================================================
   BOTTOM STATUS
===================================================== */

.status{

    position:absolute;

    bottom:25px;

    left:50%;

    transform:
        translateX(-50%);

    display:flex;

    align-items:center;

    gap:10px;

    color:#63eaff;

    font-size:10px;

    letter-spacing:4px;

    opacity:.65;

    z-index:10;
}

.status-dot{

    width:6px;
    height:6px;

    border-radius:50%;

    background:var(--cyan);

    box-shadow:
        0 0 10px var(--cyan);

    animation:
        pulse 1.5s infinite;
}

@keyframes pulse{

    0%,
    100%{
        opacity:.4;
        transform:scale(.8);
    }

    50%{
        opacity:1;
        transform:scale(1.2);
    }
}

/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:1250px){

    :root{

        --card-width:230px;
        --card-height:360px;

        --card-gap:20px;

        --title-size:50px;
    }

}

@media(max-width:1000px){

    body{
        overflow:auto;
    }

    .showroom{
        min-height:100vh;
        height:auto;
        padding:150px 30px 80px;
    }

    .bike-area{

        position:relative;

        top:auto;
        left:auto;

        transform:none;

        width:100%;

        flex-wrap:wrap;

    }

    .title{
        font-size:40px;
    }

}

@media(max-width:600px){

    .title{
        font-size:27px;
        letter-spacing:4px;
    }

    .header-small{
        font-size:9px;
        letter-spacing:5px;
    }

    .title-line{
        width:230px;
    }

    .card{
        width:260px;
        height:360px;
    }

}

/* =====================================================
   LINK RESET
===================================================== */

a{

    text-decoration:none;

    color:inherit;

}

</style>
</head>


